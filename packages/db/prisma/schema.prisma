generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum VoteValue {
  FOR
  AGAINST
  ABSTAIN
  ABSENT
}

enum EntityType {
  PARTY
  MP
}

enum ConsultationStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum ConsultationQuestionType {
  POLL
  TEXT
}

enum UserRole {
  public
  citizen
  verified_mp
  admin
  auditor
}

enum MpVerifiedStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum SourceType {
  OFFICIAL_DOC
  DEBATE
  PRESS
  STATEMENT
}

enum PromiseTheme {
  // National themes
  DEFENSIE
  WONEN
  MIGRATIE
  KLIMAAT
  ZORG
  ONDERWIJS
  ECONOMIE
  VEILIGHEID
  BESTUUR
  SOCIAAL
  LANDBOUW
  BUITENLAND
  // Municipal themes (added for gemeenteraden)
  VERKEER
  GROEN_KLIMAAT
  CULTUUR_SPORT
  JEUGD
  OPENBARE_RUIMTE
  FINANCIEN
  DIVERSITEIT
}

enum PromiseSpecificity {
  CONCRETE // Measurable target ("2% BBP defensie", "100.000 woningen")
  DIRECTIONAL // Clear direction but no metric ("meer investeren in", "aanpakken van")
  VAGUE // General aspiration ("inzetten op", "aandacht voor")
}

enum PromiseMatchType {
  EXPLICIT_MATCH // Motion directly addresses the promise
  IMPLICIT_MATCH // Motion is related but not a direct match
  CONTRADICTS // Motion goes against the promise
}

enum ProgramType {
  VERKIEZINGSPROGRAMMA
  REGEERAKKOORD
}

enum ParliamentLevel {
  NATIONAL
  MUNICIPAL
  PROVINCIAL
  EUROPEAN
}

enum PartyStatus {
  ACTIEF        // Active, normal operation
  GESPLITST     // Split into successor parties
  ONTBONDEN     // Dissolved / ceased to exist
  IN_OPRICHTING // Being formed / not yet official
  FUSIE         // Merged into another party
}

model Parliament {
  id               String          @id @default(uuid()) @db.Uuid
  slug             String          @unique // "tweede-kamer", "amsterdam", "rotterdam", etc.
  name             String // "Tweede Kamer der Staten-Generaal"
  shortName        String          @map("short_name") // "Tweede Kamer"
  level            ParliamentLevel
  country          String          @default("NL")
  municipality     String? // null for national, "amsterdam" etc. for municipal
  seats            Int // 150 for TK, 45 for Amsterdam, etc.
  active           Boolean         @default(true)
  dataSourceConfig Json?           @map("data_source_config") // { type: "notubiz", orgId: 281 } etc.
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  parties    Party[]
  mps        Mp[]
  motions    Motion[]
  votes      Vote[]
  programs   Program[]
  scorecards       PrecomputedScorecard[]
  snapshots        ScorecardSnapshot[]
  branches         PartyBranch[]
  formations       Formation[]
  pollingSnapshots PollingSnapshot[]
  memberScorecards PrecomputedMemberScorecard[]

  @@map("parliaments")
}

model PartyBranch {
  id              String  @id @default(uuid()) @db.Uuid
  partyId         String  @map("party_id") @db.Uuid
  nationalPartyId String? @map("national_party_id") @db.Uuid
  parliamentId    String  @map("parliament_id") @db.Uuid
  localName       String? @map("local_name") // e.g. "GroenLinks Amsterdam"
  seats           Int?
  isCoalition     Boolean @default(false) @map("is_coalition")
  createdAt       DateTime @default(now()) @map("created_at")

  party         Party      @relation("LocalPartyBranch", fields: [partyId], references: [id])
  nationalParty Party?     @relation("NationalPartyBranch", fields: [nationalPartyId], references: [id])
  parliament    Parliament @relation(fields: [parliamentId], references: [id])

  @@unique([partyId, parliamentId])
  @@map("party_branches")
}

model Party {
  id              String    @id @default(uuid()) @db.Uuid
  tkId            String?   @unique @map("tk_id") // Tweede Kamer Fractie ID
  name            String
  abbreviation    String
  colorNeutral    String?   @map("color_neutral")
  website         String?
  seats           Int?      // Current number of seats (fractiegrootte)
  seatsUpdatedAt  DateTime? @map("seats_updated_at") // When seat count was last synced
  startDate       DateTime? @map("start_date")
  endDate         DateTime? @map("end_date")
  parliamentId    String?   @map("parliament_id") @db.Uuid
  externalId      String?   @map("external_id") // NotuBiz/iBabs party ID
  sourceSystem    String?      @map("source_system") // "tweedekamer" | "notubiz" | "ibabs"
  partyStatus     PartyStatus  @default(ACTIEF) @map("party_status")
  statusChangedAt DateTime?    @map("status_changed_at")
  statusNote      String?      @map("status_note") // Free-text explanation
  successorPartyId String?     @map("successor_party_id") @db.Uuid
  atRisk          Boolean      @default(false) @map("at_risk") // Flagged for review (0 seats, etc.)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  parliament       Parliament? @relation(fields: [parliamentId], references: [id])
  successorParty   Party?      @relation("PartySuccessor", fields: [successorPartyId], references: [id])
  predecessors     Party[]     @relation("PartySuccessor")
  mps              Mp[]
  programs         Program[]
  motionMatches    MotionProgramMatch[]
  voteRecords      VoteRecord[]
  partyPredictions PartyPrediction[]
  scorecards       PrecomputedScorecard[]
  snapshots        ScorecardSnapshot[]
  localBranches    PartyBranch[] @relation("LocalPartyBranch")
  nationalBranches PartyBranch[] @relation("NationalPartyBranch")
  formationParticipations FormationParticipant[]
  pollingSnapshots        PollingSnapshot[]
  memberScorecards        PrecomputedMemberScorecard[]

  @@map("parties")
}

model Mp {
  id             String           @id @default(uuid()) @db.Uuid
  tkId           String           @unique @map("tk_id") // Tweede Kamer Persoon ID (also used as external ID for municipal)
  name           String
  initials       String?
  prefix         String? // tussenvoegsel (van, de, etc.)
  surname        String           @map("surname")
  partyId        String           @map("party_id") @db.Uuid
  constituency   String?
  gender         String?
  startDate      DateTime         @map("start_date")
  endDate        DateTime?        @map("end_date")
  verifiedStatus MpVerifiedStatus @default(UNVERIFIED) @map("verified_status")
  parliamentId   String?          @map("parliament_id") @db.Uuid
  externalId     String?          @map("external_id") // NotuBiz person ID, iBabs user ID
  sourceSystem   String?          @map("source_system") // "tweedekamer" | "notubiz" | "ibabs"
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  parliament    Parliament?     @relation(fields: [parliamentId], references: [id])
  party         Party           @relation(fields: [partyId], references: [id])
  sponsors      MotionSponsor[]
  voteRecords   VoteRecord[]
  consultations Consultation[]  @relation("ConsultationAuthor")
  memberScorecards PrecomputedMemberScorecard[]

  @@map("mps")
}

model Motion {
  id             String   @id @default(uuid()) @db.Uuid
  tkId           String   @unique @map("tk_id") // Tweede Kamer Besluit ID (or external ID for municipal)
  tkNumber       String?  @map("tk_number") // Kamerstukdossier nummer
  title          String
  text           String   @db.Text
  dateIntroduced DateTime @map("date_introduced")
  status         String
  result         String?  // "Aangenomen" | "Verworpen" — backfilled from Vote.result
  statusDetail   String?  @map("status_detail")
  soort          String? // Type besluit (motie, amendement, etc.)
  sourceUrl      String   @map("source_url")
  rawData        Json?    @map("raw_data") // Originele TK/NotuBiz/iBabs data
  embedding      Unsupported("vector(1536)")?
  parliamentId   String?  @map("parliament_id") @db.Uuid
  externalId     String?  @map("external_id") // NotuBiz module_item ID, iBabs EntryId
  sourceSystem   String?  @map("source_system") // "tweedekamer" | "notubiz" | "ibabs"
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  parliament     Parliament? @relation(fields: [parliamentId], references: [id])
  sponsors       MotionSponsor[]
  matches        MotionProgramMatch[]
  promiseMatches PromiseMotionMatch[]
  votes          Vote[]
  predictions    VotePrediction[]

  @@map("motions")
}

model MotionSponsor {
  motionId String @map("motion_id") @db.Uuid
  mpId     String @map("mp_id") @db.Uuid
  role     String // "indiener" or "mede-indiener"

  motion Motion @relation(fields: [motionId], references: [id], onDelete: Cascade)
  mp     Mp     @relation(fields: [mpId], references: [id])

  @@id([motionId, mpId])
  @@map("motion_sponsors")
}

model Vote {
  id           String   @id @default(uuid()) @db.Uuid
  tkId         String   @unique @map("tk_id") // Tweede Kamer Stemming ID (or generated ID for municipal)
  motionId     String?  @map("motion_id") @db.Uuid
  date         DateTime
  title        String
  result       String // "Aangenomen" or "Verworpen"
  totalFor     Int      @default(0) @map("total_for")
  totalAgainst Int      @default(0) @map("total_against")
  totalAbstain Int      @default(0) @map("total_abstain")
  sourceUrl    String   @map("source_url")
  rawData      Json?    @map("raw_data")
  parliamentId String?  @map("parliament_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  parliament Parliament? @relation(fields: [parliamentId], references: [id])
  motion     Motion?      @relation(fields: [motionId], references: [id])
  records    VoteRecord[]

  @@map("votes")
}

model VoteRecord {
  id              String    @id @default(uuid()) @db.Uuid
  voteId          String    @map("vote_id") @db.Uuid
  mpId            String    @map("mp_id") @db.Uuid
  voteValue       VoteValue @map("vote_value")
  partyIdSnapshot String    @map("party_id_snapshot") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")

  vote  Vote  @relation(fields: [voteId], references: [id], onDelete: Cascade)
  mp    Mp    @relation(fields: [mpId], references: [id])
  party Party @relation(fields: [partyIdSnapshot], references: [id])

  @@unique([voteId, mpId])
  @@map("vote_records")
}

model Program {
  id                 String      @id @default(uuid()) @db.Uuid
  partyId            String      @map("party_id") @db.Uuid
  electionYear       Int         @map("election_year")
  programType        ProgramType @default(VERKIEZINGSPROGRAMMA) @map("program_type")
  coalitionPartyIds  String[]    @default([]) @map("coalition_party_ids")
  title              String      @default("")
  sourceUrl          String      @map("source_url")
  secondarySourceUrl String?     @map("secondary_source_url")
  pdfHash            String?     @map("pdf_hash")
  pdfSizeBytes       Int?        @map("pdf_size_bytes")
  downloadedAt       DateTime?   @map("downloaded_at")
  rawText            String      @map("raw_text") @db.Text
  pageCount          Int?        @map("page_count")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  party        Party            @relation(fields: [partyId], references: [id])
  parliament   Parliament?      @relation(fields: [parliamentId], references: [id])
  passages     ProgramPassage[]
  promises     Promise[]

  parliamentId String?  @map("parliament_id") @db.Uuid

  @@unique([partyId, electionYear, programType])
  @@map("programs")
}

model ProgramPassage {
  id          String   @id @default(uuid()) @db.Uuid
  programId   String   @map("program_id") @db.Uuid
  chapter     String?
  heading     String?
  passageText String   @map("passage_text") @db.Text
  startOffset Int      @map("start_offset")
  endOffset   Int      @map("end_offset")
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime @default(now()) @map("created_at")

  program  Program              @relation(fields: [programId], references: [id], onDelete: Cascade)
  matches  MotionProgramMatch[]
  promises Promise[]

  @@map("program_passages")
}

model Position {
  id         String     @id @default(uuid()) @db.Uuid
  entityType EntityType @map("entity_type")
  entityId   String     @map("entity_id")
  claimText  String     @map("claim_text") @db.Text
  sourceType SourceType @map("source_type")
  sourceUrl  String     @map("source_url")
  sourceDate DateTime   @map("source_date")
  excerpt    String?    @db.Text
  createdAt  DateTime   @default(now()) @map("created_at")

  @@map("positions")
}

model Consultation {
  id            String             @id @default(uuid()) @db.Uuid
  createdByMpId String             @map("created_by_mp_id") @db.Uuid
  title         String
  draftText     String             @map("draft_text") @db.Text
  explanation   String             @db.Text
  status        ConsultationStatus @default(DRAFT)
  opensAt       DateTime?          @map("opens_at")
  closesAt      DateTime?          @map("closes_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  createdBy Mp                     @relation("ConsultationAuthor", fields: [createdByMpId], references: [id])
  questions ConsultationQuestion[]
  responses ConsultationResponse[]

  @@map("consultations")
}

model ConsultationQuestion {
  id             String                   @id @default(uuid()) @db.Uuid
  consultationId String                   @map("consultation_id") @db.Uuid
  questionText   String                   @map("question_text") @db.Text
  type           ConsultationQuestionType
  optionsJson    Json?                    @map("options_json")
  createdAt      DateTime                 @default(now()) @map("created_at")

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("consultation_questions")
}

model ConsultationResponse {
  id             String   @id @default(uuid()) @db.Uuid
  consultationId String   @map("consultation_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  verifiedLevel  String   @map("verified_level")
  answersJson    Json     @map("answers_json")
  createdAt      DateTime @default(now()) @map("created_at")

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@map("consultation_responses")
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique
  hashedPassword String?  @map("hashed_password")
  authProvider   String   @map("auth_provider")
  role           UserRole @default(public)
  verifiedLevel  String   @map("verified_level")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  responses ConsultationResponse[]
  auditLogs AuditLog[]

  @@map("users")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id])

  @@map("audit_logs")
}

model AlgorithmVersion {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  version     String
  description String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  active      Boolean  @default(false)

  @@map("algorithm_versions")
}

model Promise {
  id                    String             @id @default(uuid()) @db.Uuid
  programId             String             @map("program_id") @db.Uuid
  promiseCode           String             @map("promise_code") // e.g. "VVD-2023-DEF-01"
  text                  String             @db.Text // Exact quote from program
  summary               String // One-line paraphrase
  theme                 PromiseTheme
  specificity           PromiseSpecificity
  pageRef               String?            @map("page_ref") // Page number(s) in PDF
  passageId             String?            @map("passage_id") @db.Uuid // Link to source passage
  expectedVoteDirection String?            @map("expected_vote_direction") // "FOR" or "AGAINST" when consistent
  extractedBy           String             @map("extracted_by") // "manual" or "llm-assisted"
  keywords              String[]           @default([]) // Thematic keywords for matching
  sourceRef             String?            @map("source_ref") // Page/chapter reference in PDF
  reviewedBy            String?            @map("reviewed_by")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  program       Program              @relation(fields: [programId], references: [id], onDelete: Cascade)
  passage       ProgramPassage?      @relation(fields: [passageId], references: [id])
  motionMatches PromiseMotionMatch[]

  @@unique([programId, promiseCode])
  @@map("promises")
}

model PromiseMotionMatch {
  id                 String           @id @default(uuid()) @db.Uuid
  promiseId          String           @map("promise_id") @db.Uuid
  motionId           String           @map("motion_id") @db.Uuid
  matchType          PromiseMatchType @map("match_type")
  confidence         Float            @default(0) // 0-1 confidence score
  rationale          String?          @db.Text // Why this match was made
  matchMethod        String           @map("match_method") // "manual", "keyword-overlap-v2", "semantic-claude"
  algorithmVersion   String?          @map("algorithm_version")
  predictedDirection String?          @map("predicted_direction") // "VOOR" or "TEGEN" — semantic matcher prediction
  intentionLabel     String?          @map("intention_label") // PRO, CONTRA, NEUTRAL — second-pass intention classification
  intentionRationale String?          @map("intention_rationale") @db.Text // Why this intention was assigned
  reviewStatus       String?          @map("review_status") // PENDING_REVIEW, APPROVED, REJECTED — for manual review queue
  reviewedBy         String?          @map("reviewed_by")
  reviewedAt         DateTime?        @map("reviewed_at")
  createdAt          DateTime         @default(now()) @map("created_at")

  promise Promise @relation(fields: [promiseId], references: [id], onDelete: Cascade)
  motion  Motion  @relation(fields: [motionId], references: [id], onDelete: Cascade)

  @@unique([promiseId, motionId])
  @@map("promise_motion_matches")
}

model MotionProgramMatch {
  id            String   @id @default(uuid()) @db.Uuid
  motionId      String   @map("motion_id") @db.Uuid
  partyId       String   @map("party_id") @db.Uuid
  passageId     String   @map("passage_id") @db.Uuid
  score         Float
  rationaleJson Json     @map("rationale_json")
  createdAt     DateTime @default(now()) @map("created_at")

  motion  Motion         @relation(fields: [motionId], references: [id], onDelete: Cascade)
  party   Party          @relation(fields: [partyId], references: [id])
  passage ProgramPassage @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@unique([motionId, partyId, passageId])
  @@map("motion_program_matches")
}

// ── Vote Predictions ──────────────────────────────────────────

model VotePrediction {
  id               String            @id @default(uuid()) @db.Uuid
  motionId         String            @map("motion_id") @db.Uuid
  algorithmVersion String            @map("algorithm_version") // e.g. "keyword-v1"
  createdAt        DateTime          @default(now()) @map("created_at")

  motion           Motion            @relation(fields: [motionId], references: [id], onDelete: Cascade)
  partyPredictions PartyPrediction[]

  @@unique([motionId, algorithmVersion])
  @@map("vote_predictions")
}

model PartyPrediction {
  id               String         @id @default(uuid()) @db.Uuid
  votePredictionId String         @map("vote_prediction_id") @db.Uuid
  partyId          String         @map("party_id") @db.Uuid
  predictedVote    String         @map("predicted_vote") // "FOR", "AGAINST", "UNKNOWN"
  confidence       Float          @default(0)
  rationale        String?        @db.Text
  createdAt        DateTime       @default(now()) @map("created_at")

  votePrediction   VotePrediction @relation(fields: [votePredictionId], references: [id], onDelete: Cascade)
  party            Party          @relation(fields: [partyId], references: [id])

  @@unique([votePredictionId, partyId])
  @@map("party_predictions")
}

model RawIngest {
  id           String   @id @default(uuid()) @db.Uuid
  source       String // "TK_ODATA", "TK_SYNCFEED"
  resourceType String   @map("resource_type") // "Besluit", "Stemming", "Persoon", "Fractie"
  resourceId   String   @map("resource_id") // TK ID
  sourceUrl    String?  @map("source_url")
  payload      Json
  fetchedAt    DateTime @default(now()) @map("fetched_at")

  @@index([source, resourceType, resourceId])
  @@map("raw_ingest")
}

model SyncState {
  id           String   @id @default(uuid()) @db.Uuid
  source       String   @unique // "TK_BESLUITEN", "TK_STEMMINGEN", etc.
  lastSyncedAt DateTime @map("last_synced_at")
  lastSyncedId String?  @map("last_synced_id") // Voor pagination/cursor
  metadata     Json? // Extra sync state info
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("sync_state")
}

// ── Pre-computed Scorecards ──────────────────────────────────

model PrecomputedScorecard {
  id               String      @id @default(uuid()) @db.Uuid
  partyId          String      @map("party_id") @db.Uuid
  electionYear     Int         @map("election_year")
  programType      ProgramType @default(VERKIEZINGSPROGRAMMA) @map("program_type")

  // Core scorecard data
  mcs              Float                    // Motion Consistency Score (0-100)
  totalPromises    Int         @map("total_promises")
  scoredPromises   Int         @map("scored_promises")
  consistentCount  Int         @map("consistent_count")
  inconsistentCount Int        @map("inconsistent_count")
  mixedCount       Int         @map("mixed_count")

  // Full scorecard JSON blob for the detail view
  detailJson       Json        @map("detail_json")

  // Metadata
  computedAt       DateTime    @default(now()) @map("computed_at")
  algorithmVersion String      @default("keyword-v2") @map("algorithm_version")

  party            Party       @relation(fields: [partyId], references: [id])
  parliament       Parliament? @relation(fields: [parliamentId], references: [id])

  parliamentId     String?     @map("parliament_id") @db.Uuid

  @@unique([partyId, electionYear, programType])
  @@index([electionYear])
  @@map("precomputed_scorecards")
}

// ── Scorecard Snapshots (time-series for trend charts) ──────

model ScorecardSnapshot {
  id               String      @id @default(uuid()) @db.Uuid
  partyId          String      @map("party_id") @db.Uuid
  parliamentId     String?     @map("parliament_id") @db.Uuid
  electionYear     Int         @map("election_year")
  programType      ProgramType @default(VERKIEZINGSPROGRAMMA) @map("program_type")

  mcs              Float
  scoredPromises   Int         @map("scored_promises")
  consistentCount  Int         @map("consistent_count")
  inconsistentCount Int        @map("inconsistent_count")
  mixedCount       Int         @map("mixed_count")

  snapshotMonth    DateTime    @map("snapshot_month") @db.Date // First of month, e.g. 2025-01-01
  algorithmVersion String      @default("semantic-claude-v1") @map("algorithm_version")
  createdAt        DateTime    @default(now()) @map("created_at")

  party            Party       @relation(fields: [partyId], references: [id])
  parliament       Parliament? @relation(fields: [parliamentId], references: [id])

  @@unique([partyId, electionYear, programType, snapshotMonth])
  @@index([parliamentId, snapshotMonth])
  @@map("scorecard_snapshots")
}

// ── Precomputed Member Scorecards (for MP ranking) ──────────

model PrecomputedMemberScorecard {
  id                String   @id @default(uuid()) @db.Uuid
  mpId              String   @map("mp_id") @db.Uuid
  partyId           String   @map("party_id") @db.Uuid
  parliamentId      String   @map("parliament_id") @db.Uuid
  electionYear      Int      @map("election_year")

  mcs               Float    // Personal MCS (0-100)
  scoredPromises    Int      @map("scored_promises")
  consistentCount   Int      @map("consistent_count")
  inconsistentCount Int      @map("inconsistent_count")
  mixedCount        Int      @map("mixed_count")
  partyMcs          Float    @map("party_mcs")
  divergenceFromParty Float  @map("divergence_from_party")
  votesAnalyzed     Int      @map("votes_analyzed")

  topAlignedThemes    String[] @map("top_aligned_themes")
  topMisalignedThemes String[] @map("top_misaligned_themes")

  computedAt        DateTime @default(now()) @map("computed_at")

  mp         Mp         @relation(fields: [mpId], references: [id])
  party      Party      @relation(fields: [partyId], references: [id])
  parliament Parliament @relation(fields: [parliamentId], references: [id])

  @@unique([mpId, parliamentId, electionYear])
  @@index([parliamentId, electionYear, mcs(sort: Desc)])
  @@map("precomputed_member_scorecards")
}

// ── Pipeline Runs ────────────────────────────────────────────

enum PipelineStatus {
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

model PipelineRun {
  id                 String         @id @default(uuid()) @db.Uuid
  status             PipelineStatus @default(RUNNING)
  trigger            String         @default("scheduled")
  startedAt          DateTime       @default(now()) @map("started_at")
  completedAt        DateTime?      @map("completed_at")
  durationMs         Int?           @map("duration_ms")
  steps              Json           @default("[]")
  motionsSynced      Int            @default(0) @map("motions_synced")
  votesSynced        Int            @default(0) @map("votes_synced")
  sponsorsSynced     Int            @default(0) @map("sponsors_synced")
  matchesCreated     Int            @default(0) @map("matches_created")
  scorecardsComputed Int            @default(0) @map("scorecards_computed")
  errorMessage       String?        @map("error_message") @db.Text
  errorStep          String?        @map("error_step")

  @@index([startedAt(sort: Desc)])
  @@index([status])
  @@map("pipeline_runs")
}

// ── Polling Snapshots (Peilingwijzer / I&O Research) ───────

model PollingSnapshot {
  id             String     @id @default(uuid()) @db.Uuid
  partyId        String     @map("party_id") @db.Uuid
  parliamentId   String     @map("parliament_id") @db.Uuid
  source         String     // "peilingwijzer", "io_research", "ipsos"
  pollDate       DateTime   @map("poll_date") @db.Date
  seats          Float?     // Projected seats (e.g. 23.5)
  percentage     Float?     // Vote share percentage
  createdAt      DateTime   @default(now()) @map("created_at")

  party          Party      @relation(fields: [partyId], references: [id])
  parliament     Parliament @relation(fields: [parliamentId], references: [id])

  @@unique([partyId, parliamentId, source, pollDate])
  @@index([parliamentId, pollDate])
  @@map("polling_snapshots")
}

// ── Citizen Feedback ────────────────────────────────────────

model Feedback {
  id           String   @id @default(uuid()) @db.Uuid
  page         String   // e.g. "/parties/pvv/scorecard"
  message      String   @db.Text
  email        String?  // optional contact
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("feedback")
}

// ── Pillar Infrastructure Tables ────────────────────────────

model PipelineDocument {
  id              String    @id @default(uuid()) @db.Uuid
  country         String    // "NL", "universal", "DE"
  pillar          Int       // 1-5
  sourceType      String    @map("source_type") // e.g. "coalition_accord", "eu_directive", "lobby_report"
  sourceUrl       String    @map("source_url")
  r2Path          String?   @map("r2_path") // r2://civicstat/{country}/{pillar}/{source_type}/{year}/{id}.ext
  weaviateId      String?   @map("weaviate_id")
  publicationDate DateTime? @map("publication_date")
  language        String    @default("nl") // ISO 639-1
  processedAt     DateTime? @map("processed_at")
  parliamentSlug  String?   @map("parliament_slug")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  topicClassifications TopicClassification[]

  @@index([country, pillar])
  @@index([parliamentSlug])
  @@map("pipeline_documents")
}

model PillarScore {
  id             String   @id @default(uuid()) @db.Uuid
  partySlug      String   @map("party_slug")
  parliamentSlug String   @map("parliament_slug")
  pillar         Int      // 1-5
  topic          String   // MARPOR category code
  alignmentPct   Float    @map("alignment_pct") // 0-100
  evidenceCount  Int      @map("evidence_count")
  computedAt     DateTime @default(now()) @map("computed_at")

  @@unique([partySlug, parliamentSlug, pillar, topic])
  @@index([parliamentSlug, pillar])
  @@map("pillar_scores")
}

enum OrgType {
  EU_GROUP
  THINK_TANK
  LOBBY
  INTL_ORG
}

model InfluenceAffiliation {
  id               String    @id @default(uuid()) @db.Uuid
  partySlug        String    @map("party_slug")
  orgName          String    @map("org_name")
  orgType          OrgType   @map("org_type")
  affiliationStart DateTime? @map("affiliation_start")
  affiliationEnd   DateTime? @map("affiliation_end")
  notes            String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")

  @@unique([partySlug, orgName])
  @@index([orgType])
  @@map("influence_affiliations")
}

model TopicClassification {
  id             String @id @default(uuid()) @db.Uuid
  documentId     String @map("document_id") @db.Uuid
  marporCategory String @map("marpor_category") // MARPOR category code
  confidenceScore Float @map("confidence_score") // 0-1

  document PipelineDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([marporCategory])
  @@map("topic_classifications")
}

// ── Formatie (Coalition Formation) Tracking ─────────────────

enum FormatiePhase {
  VERKENNING    // Exploration phase (verkenner appointed)
  INFORMATIE    // Information phase (informateur appointed)
  FORMATIE      // Formation phase (formateur appointed)
  AFGEROND      // Formation completed — coalition formed
  MISLUKT       // Formation failed
}

model Formation {
  id             String        @id @default(uuid()) @db.Uuid
  parliamentId   String        @map("parliament_id") @db.Uuid
  electionDate   DateTime      @map("election_date") @db.Date
  phase          FormatiePhase @default(VERKENNING)
  currentLeader  String?       @map("current_leader")  // Name of verkenner/informateur/formateur
  leaderRole     String?       @map("leader_role")      // "verkenner", "informateur", "formateur"
  notes          String?       @db.Text
  startedAt      DateTime      @default(now()) @map("started_at")
  completedAt    DateTime?     @map("completed_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  parliament     Parliament    @relation(fields: [parliamentId], references: [id])
  rounds         FormationRound[]
  participants   FormationParticipant[]

  @@unique([parliamentId, electionDate])
  @@index([parliamentId])
  @@map("formations")
}

model FormationRound {
  id           String        @id @default(uuid()) @db.Uuid
  formationId  String        @map("formation_id") @db.Uuid
  roundNumber  Int           @map("round_number")
  phase        FormatiePhase
  leader       String        // Name of informateur/formateur for this round
  leaderRole   String        @map("leader_role")
  startedAt    DateTime      @map("started_at")
  endedAt      DateTime?     @map("ended_at")
  outcome      String?       // Brief outcome description
  notes        String?       @db.Text
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  formation    Formation     @relation(fields: [formationId], references: [id], onDelete: Cascade)

  @@unique([formationId, roundNumber])
  @@map("formation_rounds")
}

model FormationParticipant {
  id           String    @id @default(uuid()) @db.Uuid
  formationId  String    @map("formation_id") @db.Uuid
  partyId      String    @map("party_id") @db.Uuid
  status       String    @default("deelnemend") // "deelnemend", "afgehaakt", "uitgenodigd", "geweigerd"
  joinedAt     DateTime  @default(now()) @map("joined_at")
  leftAt       DateTime? @map("left_at")
  notes        String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  formation    Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  party        Party     @relation(fields: [partyId], references: [id])

  @@unique([formationId, partyId])
  @@map("formation_participants")
}

enum UpdateCategory {
  NIEUWE_DATA
  NIEUWE_ANALYSE
  VERBETERING
  BUGFIX
}

model PlatformUpdate {
  id        String          @id @default(uuid()) @db.Uuid
  title     String          @db.VarChar(255)
  body      String          @db.Text
  category  UpdateCategory?
  linkUrl   String?         @map("link_url") @db.VarChar(512)
  linkLabel String?         @map("link_label") @db.VarChar(255)
  publishedAt DateTime      @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([publishedAt(sort: Desc)])
  @@map("platform_updates")
}

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique @db.VarChar(64)
  name        String    @db.VarChar(255)
  email       String    @db.VarChar(255)
  rateLimit   Int       @default(1000) @map("rate_limit")
  active      Boolean   @default(true)
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")

  @@index([key])
  @@index([email])
  @@map("api_keys")
}
